# ── Mollie Connect OAuth app (created in your PLATFORM account) ──────────────
# Dashboard → Developers → Your apps → Create app
# Use a DEDICATED app for this PoC — never an app that serves production
# merchants, since approval_prompt=force revokes their existing authorizations.
MOLLIE_CLIENT_ID=app_xxxxxxxxxxxxxxxx
MOLLIE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Public base URL (ngrok) ──────────────────────────────────────────────────
# Mollie will not accept localhost for webhookUrl / redirectUrl.
# Run:  ngrok http 3000     then paste the https URL here (no trailing slash).
# This exact URL + /api/connect/callback must be the redirect URI on your app.
PUBLIC_URL=https://your-subdomain.ngrok-free.dev

# ── Redirect URI (only if the dashboard has something other than the default) ─
# Default sent to Mollie is PUBLIC_URL + /api/connect/callback. Override here if
# the app's registered Redirect URL differs and you can't change it.
MOLLIE_REDIRECT_URI=

# Set to true to omit redirect_uri entirely — Mollie then uses whatever the app
# has registered. Useful to diagnose "redirect URI does not match".
MOLLIE_OMIT_REDIRECT_URI=false

# 'auto' (default) or 'force'. 'force' always re-shows the consent screen but
# REVOKES previous authorizations for the app — only safe on a throwaway app.
MOLLIE_APPROVAL_PROMPT=auto

# ── Optional: platform application fee ───────────────────────────────────────
# Percentage of each payment, e.g. 5 for 5%. Takes precedence over the fixed
# amount below. Leave both empty to disable.
#
# Mollie constraints, enforced in src/lib/config.ts:
#   min €0.01; max = total - (€0.35 + 6% of total), so tiny payments carry none
#   cannot be charged to the same organization that created the OAuth app
#   in test mode it shows on the payment but never settles to a balance
APPLICATION_FEE_PERCENT=5

# Fixed fee in EUR, used only when no percentage is set.
APPLICATION_FEE_AMOUNT=
APPLICATION_FEE_DESCRIPTION=Platform fee
